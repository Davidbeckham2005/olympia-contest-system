PORT=3001

# sqlite | mysql
DB_CLIENT=sqlite

# Bật SSL nối tới MySQL (VD: MySQL của Render yêu cầu TLS)
# true | false
DB_SSL=false

# Có thể cung cấp connection string thay cho các biến DB_* bên dưới
# (ưu tiên nếu được set):
# DATABASE_URL=mysql://user:pass@host:3306/cuoc_thi

# Chỉ cần khi DB_CLIENT=mysql (hoặc khi không dùng DATABASE_URL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cuoc_thi
