PORT=3001

# sqlite | mysql | postgres
DB_CLIENT=sqlite

# Bật SSL nối tới DB (VD: Postgres/MySQL của Render yêu cầu TLS)
# true | false
DB_SSL=false

# Có thể cung cấp connection string thay cho các biến DB_* bên dưới
# (ưu tiên nếu được set):
# DATABASE_URL=mysql://user:pass@host:3306/cuoc_thi
# DATABASE_URL=postgres://user:pass@host:5432/cuoc_thi

# Chỉ cần khi DB_CLIENT != sqlite (hoặc khi không dùng DATABASE_URL)
DB_HOST=localhost
# MySQL: 3306 | Postgres: 5432
DB_PORT=5432
DB_USER=root
DB_PASSWORD=
DB_NAME=cuoc_thi