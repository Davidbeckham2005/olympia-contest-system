{
  "name": "cuoc-thi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm run server\" \"npm run client\"",
    "server": "node --watch server/index.js",
    "client": "node scripts/wait-for-server.mjs && npm run dev --prefix client",
    "setup": "npm install && npm install --prefix client",
    "start": "node server/index.js",
    "build": "npm run build --prefix client"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "multer": "1.4.5-lts.1",
    "mysql2": "^3.23.3",
    "pg": "^8.23.0",
    "socket.io": "^4.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
